# ===========================================================================
# AI Platform Engine (APE) — Docker Compose environment.
#
# Copy this file to `.env` in the repository root, replace every ***
# secret, then start with: docker compose up -d --build
#
# `.env` is Docker Compose's standard local runtime configuration file. For a
# host Python venv, use backend/.env instead.
# ===========================================================================

# Application and browser access
APE_APP__NAME=AI Platform Engine
APE_APP__ENV=production
APE_APP__DEBUG=false
APE_APP__VERSION=0.9.0
APE_APP__API_V1_PREFIX=/api/v1
APE_SERVER__HOST=0.0.0.0
APE_SERVER__PORT=8000
APE_SERVER__RELOAD=false
APE_RUNTIME__PROFILE=hosted_openai
APE_LOGGING__LEVEL=INFO
APE_LOGGING__RENDER_JSON=true
APE_CORS__ALLOW_ORIGINS=https://rag-builder.example.com
APE_CORS__ALLOW_CREDENTIALS=true
APE_CORS__ALLOW_METHODS=*
APE_CORS__ALLOW_HEADERS=*
# Leave blank on the VPS so host Nginx provides same-origin API routing. For a
# static local Compose console, set http://127.0.0.1:8010 and add the console
# origin to APE_CORS__ALLOW_ORIGINS.
VITE_API_ORIGIN=

# Authentication and Super Admin browser sessions; replace all *** values.
APE_AUTH__ENABLED=true
APE_AUTH__KEY_PEPPER=***
APE_AUTH__VERIFY_CACHE_ENABLED=true
APE_AUTH__VERIFY_CACHE_TTL_SECONDS=300
APE_AUTH__VERIFY_CACHE_BACKEND=redis
APE_AUTH__RATE_LIMIT_ENABLED=true
APE_AUTH__RATE_LIMIT_REQUESTS=10000
APE_AUTH__RATE_LIMIT_WINDOW_SECONDS=60
APE_AUTH__RATE_LIMIT_FAIL_OPEN=false
APE_AUTH__ADMIN_LOGIN_RATE_LIMIT_REQUESTS=5
APE_AUTH__ADMIN_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
APE_AUTH__ADMIN_JWT_SECRET=***
APE_AUTH__ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=15
APE_AUTH__ADMIN_REFRESH_TOKEN_EXPIRE_DAYS=14
APE_AUTH__ADMIN_COOKIE_SECURE=true
APE_AUTH__ADMIN_COOKIE_SAMESITE=lax
APE_AUTH__ADMIN_COOKIE_DOMAIN=

# Signed document outcome callbacks.
APE_WEBHOOKS__ENABLED=true
APE_WEBHOOKS__DISPATCHER_ENABLED=true
APE_WEBHOOKS__SIGNING_KEY=***
APE_WEBHOOKS__DISPATCHER_POLL_SECONDS=1.0
APE_WEBHOOKS__DISPATCHER_BATCH_SIZE=50
APE_WEBHOOKS__DELIVERY_TIMEOUT_SECONDS=10
APE_WEBHOOKS__DELIVERY_LEASE_SECONDS=60
APE_WEBHOOKS__MAX_ATTEMPTS=6
APE_WEBHOOKS__RETRY_BASE_SECONDS=5
APE_WEBHOOKS__RETRY_MAX_SECONDS=3600
APE_WEBHOOKS__RESPONSE_EXCERPT_CHARS=1000

# Docker infrastructure. Compose maps application connections to service DNS.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=***
POSTGRES_DB=rag_builder
POSTGRES_PORT=5432
APE_DATABASE__ECHO=false
APE_DATABASE__POOL_SIZE=5
APE_DATABASE__MAX_OVERFLOW=10
APE_DATABASE__POOL_TIMEOUT=30
APE_DATABASE__POOL_RECYCLE=1800
REDIS_PORT=6379
REDIS_PASSWORD=***
APE_REDIS__DB=0
MINIO_ROOT_USER=ragbuilder
MINIO_ROOT_PASSWORD=***
MINIO_BUCKET=ape-artifacts
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
APE_MINIO__SECURE=false
APE_MINIO__REGION=us-east-1
APE_STORAGE__BACKEND=minio
APE_STORAGE__LOCAL_ROOT=/data/storage

# Background jobs, uploads, parsing, and chunking.
APE_JOBS__BACKEND=taskiq
APE_JOBS__DISPATCHER_ENABLED=true
APE_JOBS__DISPATCHER_POLL_SECONDS=1.0
APE_JOBS__DISPATCHER_BATCH_SIZE=50
APE_JOBS__LEASE_SECONDS=300
APE_JOBS__HEARTBEAT_SECONDS=30
APE_JOBS__MAX_ATTEMPTS=3
APE_JOBS__RETRY_BASE_DELAY_SECONDS=2.0
APE_JOBS__RETRY_MAX_DELAY_SECONDS=300
APE_JOBS__DISPATCH_RETRY_BASE_SECONDS=1.0
APE_JOBS__DISPATCH_RETRY_MAX_SECONDS=60
APE_KNOWLEDGE__MAX_UPLOAD_BYTES=52428800
APE_PARSING__PDF_TEXT_PARSERS=pymupdf,pdfium
APE_PARSING__MIN_PAGE_QUALITY_SCORE=0.55
APE_PARSING__MIN_DOCUMENT_SUCCESS_RATIO=0.2
APE_PARSING__MIN_TEXT_CHARS=20
APE_CHUNKING__STRATEGY=auto
APE_CHUNKING__TARGET_TOKENS=250
APE_CHUNKING__MAX_TOKENS=400
APE_CHUNKING__MIN_TOKENS=50
APE_CHUNKING__OVERLAP_TOKENS=50
APE_CHUNKING__STRUCTURE_SCORE_THRESHOLD=0.55
APE_CHUNKING__LONG_BLOCK_TOKEN_THRESHOLD=600
APE_CHUNKING__SIMILARITY_DROP_THRESHOLD=0.35
APE_CHUNKING__SEMANTIC_BATCH_SIZE=32
APE_CHUNKING__TOKEN_COUNT_METHOD=unicode_property_v1
APE_CHUNKING__OCR_CONFIDENCE_THRESHOLD=0.5

# Google Vision is Docker-ready without the optional Paddle dependencies.
APE_OCR__ENABLED=true
APE_OCR__BACKEND=google_vision
APE_OCR__BANGLA_BACKEND=google_vision
APE_OCR__LANG=en
APE_OCR__GOOGLE_API_KEY=***
APE_OCR__GOOGLE_ENDPOINT=https://vision.googleapis.com/v1/images:annotate
APE_OCR__GOOGLE_TIMEOUT_SECONDS=30
APE_OCR__GOOGLE_MAX_ATTEMPTS=3
APE_OCR__BANGLA_MIN_RATIO=0.10
APE_OCR__MAX_OCR_PAGES_PER_DOCUMENT=200
APE_OCR__USE_GPU=false
APE_OCR__MIN_TEXT_CHARS=20
APE_OCR__MIN_IMAGE_AREA_RATIO=0.08
APE_OCR__DPI=200
APE_OCR__MIN_PAGE_CONFIDENCE=0.3
APE_MALWARE_SCAN__BACKEND=clamav
APE_MALWARE_SCAN__HOST=clamav
APE_MALWARE_SCAN__PORT=3310
APE_MALWARE_SCAN__TIMEOUT_SECONDS=15

# OpenAI providers; embedding dimensions must match the database schema.
APE_EMBEDDING__BACKEND=openai
APE_EMBEDDING__MODEL=text-embedding-3-large
APE_EMBEDDING__DIMENSIONS=1024
APE_EMBEDDING__BATCH_SIZE=32
APE_EMBEDDING__OPENAI_API_KEY=***
APE_EMBEDDING__OPENAI_BASE_URL=https://api.openai.com
APE_EMBEDDING__OLLAMA_BASE_URL=http://host.docker.internal:11434
APE_EMBEDDING__GEMINI_API_KEY=
APE_EMBEDDING__GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
APE_LLM__BACKEND=openai
APE_LLM__MODEL=gpt-4o-mini
# Optional intentional override; omit to use the provider/model default.
# APE_LLM__TEMPERATURE=0.7
APE_LLM__MAX_TOKENS=2048
APE_LLM__REQUEST_TIMEOUT_SECONDS=120
APE_LLM__OPENAI_API_KEY=***
APE_LLM__OPENAI_BASE_URL=https://api.openai.com
APE_LLM__OLLAMA_BASE_URL=http://host.docker.internal:11434
APE_LLM__GEMINI_API_KEY=
APE_LLM__GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Hybrid retrieval and contextual answer settings.
APE_RETRIEVAL__AUTO_EMBED=true
APE_RETRIEVAL__AUTO_INDEX=true
APE_RETRIEVAL__DEFAULT_TOP_K=10
APE_RETRIEVAL__EMBEDDING_SET_VERSION=2
APE_RETRIEVAL__FILTERABLE_METADATA_KEYS=source,tags,ocr_confidence
APE_RETRIEVAL__STRATEGY=hybrid
APE_AI_POLICY__REQUEST_OVERRIDE_MODE=compatibility
APE_AI_POLICY__MAX_REQUEST_TOP_K=100
APE_AI_POLICY__ENABLED_RETRIEVAL_STRATEGIES=semantic,hybrid
APE_AI_POLICY__SOURCE_POLICY_DEPLOYMENT_CAP=enforce
APE_RETRIEVAL__SEMANTIC_CANDIDATE_TOP_K=50
APE_RETRIEVAL__HNSW_EF_SEARCH=100
APE_RETRIEVAL__KEYWORD_CANDIDATE_TOP_K=50
APE_RETRIEVAL__RRF_K=60
APE_RETRIEVAL__SEMANTIC_WEIGHT=1.0
APE_RETRIEVAL__KEYWORD_WEIGHT=1.0
APE_RETRIEVAL__RERANK_ENABLED=true
APE_RETRIEVAL__RERANK_TOP_N=20
APE_RETRIEVAL__RERANKER_BACKEND=noop
APE_RETRIEVAL__FTS_REGCONFIG=simple
APE_RETRIEVAL__MAX_CHUNKS_PER_DOCUMENT=4
APE_RETRIEVAL__MAX_CHUNKS_PER_SECTION=2
APE_RETRIEVAL__DEDUPLICATE_BY_CONTENT_HASH=true
APE_RETRIEVAL__PASSAGE_SCORING_ENABLED=false
APE_RETRIEVAL__PASSAGE_WINDOW_TOKENS=96
APE_RETRIEVAL__PASSAGE_OVERLAP_TOKENS=24
APE_RETRIEVAL__PASSAGE_MIN_TOKENS=32
APE_GENERATION__MAX_REQUEST_BYTES=262144
APE_GENERATION__MAX_CONTEXT_BYTES=204800
APE_GENERATION__MAX_SCHEMA_BYTES=32768
APE_GENERATION__MAX_CONTEXT_DEPTH=12
APE_GENERATION__MAX_CONTEXT_NODES=5000
APE_GENERATION__DEFAULT_RETENTION=none
APE_GENERATION__ALLOW_FULL_RETENTION=true
APE_CHAT__RETRIEVAL_TOP_K=10
APE_CHAT__MAX_CONTEXT_CHUNKS=8
APE_CHAT__CONTEXT_CHAR_BUDGET=12000
APE_CHAT__MAX_HISTORY_MESSAGES=20
APE_CHAT__SYSTEM_PROMPT_VERSION=v4
APE_CHAT__INCLUDE_CITATIONS=true
APE_CHAT__CITATION_EXCERPT_MAX_CHARS=200
APE_CHAT__EVIDENCE_SCORE_MODE=whole_chunk
APE_CHAT__MINIMUM_SEMANTIC_EVIDENCE_SCORE=0.35
APE_CHAT__LEXICAL_CORROBORATION_FLOOR_SCORE=0.30
APE_CHAT__LEXICAL_CORROBORATION_COVERAGE=0.50
APE_CHAT__MINIMUM_CLAIM_TOKEN_COVERAGE=0.35
APE_CHAT__AUTO_TITLE_MAX_CHARS=80
APE_EVALUATION__RERANKER_CANDIDATES=lexical,embedding,embedding_max
APE_EVALUATION__MINIMUM_RANK_1_ACCURACY=0.80
APE_EVALUATION__MAXIMUM_ACCEPTED_WITHOUT_RELEVANT_EVIDENCE_RATE=0.0
