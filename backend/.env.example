# ===========================================================================
# AI Platform Engine (APE) - backend local environment template.
#
# Copy to `.env` and adjust as needed (run from the backend/ directory):
#     cp .env.example .env            (macOS/Linux)
#     Copy-Item .env.example .env     (Windows PowerShell)
#
# Consumed by the FastAPI application (Pydantic Settings). All keys use the
# APE_ prefix with double-underscore nesting, e.g. APE_DATABASE__HOST.
#
# Hosts are localhost — use this file when running the API in a local venv
# against infrastructure started via docker compose from the repo root.
# For the full Docker stack, use the root `.env` file instead.
# ===========================================================================

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
APE_APP__NAME=AI Platform Engine
# One of: development | testing | production
APE_APP__ENV=development
APE_APP__DEBUG=true
APE_APP__VERSION=0.9.0
APE_APP__API_V1_PREFIX=/api/v1

# ----------------------------------------------------------------------------
# Server (uvicorn) — used by `python -m app` from backend/
# For explicit CLI flags instead, run: uvicorn app.main:app --reload --host 0.0.0.0 --port 8088
# ----------------------------------------------------------------------------
APE_SERVER__HOST=0.0.0.0
APE_SERVER__PORT=8088
APE_SERVER__RELOAD=true
APE_SERVER__WORKERS=1

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------
# Level: DEBUG | INFO | WARNING | ERROR | CRITICAL
APE_LOGGING__LEVEL=INFO
# true  -> JSON logs (production / log aggregation)
# false -> colorized console logs (local development)
APE_LOGGING__RENDER_JSON=false

# ----------------------------------------------------------------------------
# CORS (comma-separated, or "*" for all)
# ----------------------------------------------------------------------------
APE_CORS__ALLOW_ORIGINS=*
APE_CORS__ALLOW_CREDENTIALS=true

# ----------------------------------------------------------------------------
# PostgreSQL (local venv → localhost; docker stack uses service hostnames)
# ----------------------------------------------------------------------------
APE_DATABASE__HOST=localhost
APE_DATABASE__PORT=5432
APE_DATABASE__USER=ape
APE_DATABASE__PASSWORD=ape
APE_DATABASE__NAME=ape
APE_DATABASE__ECHO=false
APE_DATABASE__POOL_SIZE=5
APE_DATABASE__MAX_OVERFLOW=10

# Integration tests (pytest) — use a disposable database only:
#   APE_DATABASE__NAME=ape_test
#   APE_TEST_DATABASE__NAME=ape_test
#   APE_TEST_DATABASE__ALLOW_MIGRATIONS=true

# ----------------------------------------------------------------------------
# Authentication (Organization API keys + Super Admin browser session)
# ----------------------------------------------------------------------------
# Single on/off — when false, protected routes skip credential checks (dev/tests).
APE_AUTH__ENABLED=false
# APE_AUTH__ADMIN_JWT_SECRET=replace-with-32-plus-byte-random-jwt-secret
# APE_AUTH__KEY_PEPPER=change_me_min_32_bytes_random_secret
APE_AUTH__VERIFY_CACHE_ENABLED=true
APE_AUTH__VERIFY_CACHE_TTL_SECONDS=60
APE_AUTH__VERIFY_CACHE_BACKEND=memory
APE_AUTH__RATE_LIMIT_ENABLED=false
APE_AUTH__RATE_LIMIT_REQUESTS=1000
APE_AUTH__RATE_LIMIT_WINDOW_SECONDS=60
APE_AUTH__RATE_LIMIT_FAIL_OPEN=true

# Production checklist:
#   APE_AUTH__ENABLED=true
#   APE_AUTH__ADMIN_JWT_SECRET=<random, at least 32 bytes>
#   APE_AUTH__KEY_PEPPER=<random, at least 32 bytes>
#   APE_AUTH__VERIFY_CACHE_BACKEND=redis
#   APE_AUTH__RATE_LIMIT_ENABLED=true
#   APE_AUTH__RATE_LIMIT_FAIL_OPEN=false

# ----------------------------------------------------------------------------
# Signed document processing/indexing webhooks
# ----------------------------------------------------------------------------
APE_WEBHOOKS__ENABLED=true
APE_WEBHOOKS__DISPATCHER_ENABLED=true
APE_WEBHOOKS__SIGNING_KEY=development-only-webhook-signing-key
APE_WEBHOOKS__MAX_ATTEMPTS=6
APE_WEBHOOKS__DELIVERY_TIMEOUT_SECONDS=10

# ----------------------------------------------------------------------------
# Redis
# ----------------------------------------------------------------------------
APE_REDIS__HOST=localhost
APE_REDIS__PORT=6379
APE_REDIS__DB=0
# APE_REDIS__PASSWORD=

# --- Object storage (document uploads) ---
# local = filesystem under LOCAL_ROOT; minio = S3-compatible (Docker stack)
APE_STORAGE__BACKEND=local
APE_STORAGE__LOCAL_ROOT=./storage

# ----------------------------------------------------------------------------
# Background jobs (Taskiq + Redis)
# ----------------------------------------------------------------------------
APE_JOBS__BACKEND=taskiq
# Durable outbox polling and execution ownership.
# APE_JOBS__DISPATCHER_ENABLED=true
# APE_JOBS__DISPATCHER_POLL_SECONDS=1.0
# APE_JOBS__DISPATCHER_BATCH_SIZE=50
# APE_JOBS__LEASE_SECONDS=300
# APE_JOBS__HEARTBEAT_SECONDS=30
# APE_JOBS__MAX_ATTEMPTS=3
# APE_JOBS__RETRY_BASE_DELAY_SECONDS=2.0
# APE_JOBS__RETRY_MAX_DELAY_SECONDS=300.0
# APE_JOBS__DISPATCH_RETRY_BASE_SECONDS=1.0
# APE_JOBS__DISPATCH_RETRY_MAX_SECONDS=60.0

# ----------------------------------------------------------------------------
# Knowledge ingestion limits
# ----------------------------------------------------------------------------
# Maximum upload size in bytes (default 50 MB); larger uploads return 413.
# APE_KNOWLEDGE__MAX_UPLOAD_BYTES=52428800

# ----------------------------------------------------------------------------
# PDF parsing quality and fallback
# ----------------------------------------------------------------------------
# Comma-separated text parser order for PDFs: pymupdf,pdfium
# APE_PARSING__PDF_TEXT_PARSERS=pymupdf,pdfium
# APE_PARSING__MIN_PAGE_QUALITY_SCORE=0.55
# APE_PARSING__MIN_DOCUMENT_SUCCESS_RATIO=0.2
# APE_PARSING__MIN_TEXT_CHARS=20

# ----------------------------------------------------------------------------
# Text chunking (knowledge ingestion)
# ----------------------------------------------------------------------------
# Strategy: auto | markdown | heading | structure | semantic | recursive_fallback
# Token limits are approximate because embedding models tokenize differently.
APE_CHUNKING__STRATEGY=auto
APE_CHUNKING__TARGET_TOKENS=250
APE_CHUNKING__MAX_TOKENS=400
APE_CHUNKING__MIN_TOKENS=50
APE_CHUNKING__OVERLAP_TOKENS=50
APE_CHUNKING__STRUCTURE_SCORE_THRESHOLD=0.55
APE_CHUNKING__LONG_BLOCK_TOKEN_THRESHOLD=600
APE_CHUNKING__SIMILARITY_DROP_THRESHOLD=0.35
APE_CHUNKING__TOKEN_COUNT_METHOD=unicode_property_v1
APE_CHUNKING__OCR_CONFIDENCE_THRESHOLD=0.5

# ----------------------------------------------------------------------------
# OCR (optional — Paddle needs requirements/ocr.txt; Google Vision uses base dependencies)
# ----------------------------------------------------------------------------
APE_OCR__ENABLED=false
# Backend: noop | paddle | google_vision
APE_OCR__BACKEND=noop
APE_OCR__BANGLA_BACKEND=noop
APE_OCR__LANG=en
# Per-document override: upload form field ocr_lang or reprocess?ocr_lang=<code>
# Set BANGLA_BACKEND=google_vision and provide GOOGLE_API_KEY for Bengali OCR.
APE_OCR__GOOGLE_API_KEY=
APE_OCR__GOOGLE_ENDPOINT=https://vision.googleapis.com/v1/images:annotate
APE_OCR__GOOGLE_TIMEOUT_SECONDS=30
APE_OCR__GOOGLE_MAX_ATTEMPTS=3
APE_OCR__BANGLA_MIN_RATIO=0.10
APE_OCR__MAX_OCR_PAGES_PER_DOCUMENT=100
APE_OCR__USE_GPU=false
APE_OCR__MIN_TEXT_CHARS=20
APE_OCR__MIN_IMAGE_AREA_RATIO=0.08
APE_OCR__DPI=200
APE_OCR__MIN_PAGE_CONFIDENCE=0.3

# ----------------------------------------------------------------------------
# Embeddings (cheap local default is hash; hosted_managed uses Cohere)
# Changing backend or model requires a new embedding_set_version and rebuild.
# ----------------------------------------------------------------------------
# Backend: hash | ollama | openai | gemini | cohere
APE_EMBEDDING__BACKEND=hash
APE_EMBEDDING__MODEL=text-embedding-3-large
APE_EMBEDDING__DIMENSIONS=1024
APE_EMBEDDING__BATCH_SIZE=32
APE_EMBEDDING__OLLAMA_BASE_URL=http://localhost:11434
# APE_EMBEDDING__OPENAI_API_KEY=
# APE_EMBEDDING__OPENAI_BASE_URL=https://api.openai.com
# APE_EMBEDDING__GEMINI_API_KEY=
# APE_EMBEDDING__GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Shared Cohere key for embed + rerank when backend=cohere (canonical):
# APE_COHERE__API_KEY=

# ----------------------------------------------------------------------------
# PostgreSQL-native semantic retrieval
# ----------------------------------------------------------------------------
# PostgreSQL must have the vector extension. The configured dimension must
# match chunk_embeddings.embedding vector(n); changes require a migration and
# full re-embedding.

# ----------------------------------------------------------------------------
# Retrieval pipeline
# ----------------------------------------------------------------------------
APE_RETRIEVAL__AUTO_EMBED=true
APE_RETRIEVAL__AUTO_INDEX=true
APE_RETRIEVAL__DEFAULT_TOP_K=10
# Local/pytest stay on 2 + hash embeddings. hosted_managed Cohere uses 3.
APE_RETRIEVAL__EMBEDDING_SET_VERSION=2
APE_RETRIEVAL__FILTERABLE_METADATA_KEYS=source,tags,ocr_confidence
# PostgreSQL FTS regconfig — use simple for multilingual corpora
APE_RETRIEVAL__FTS_REGCONFIG=simple
# Optional minimum OCR confidence for keyword retrieval (omit to disable)
# APE_RETRIEVAL__MIN_OCR_CONFIDENCE=0.5
# Production retrieval strategy: semantic | hybrid
APE_RETRIEVAL__STRATEGY=hybrid
APE_AI_POLICY__REQUEST_OVERRIDE_MODE=compatibility
APE_AI_POLICY__MAX_REQUEST_TOP_K=100
APE_AI_POLICY__ENABLED_RETRIEVAL_STRATEGIES=semantic,hybrid
APE_AI_POLICY__SOURCE_POLICY_DEPLOYMENT_CAP=enforce
APE_RETRIEVAL__SEMANTIC_CANDIDATE_TOP_K=50
APE_RETRIEVAL__HNSW_EF_SEARCH=100
APE_RETRIEVAL__KEYWORD_CANDIDATE_TOP_K=50
APE_RETRIEVAL__RRF_K=60
APE_RETRIEVAL__SEMANTIC_WEIGHT=1.0
APE_RETRIEVAL__KEYWORD_WEIGHT=1.0
# Legacy boolean; prefer RERANK_MODE (always | cross_language | off).
APE_RETRIEVAL__RERANK_ENABLED=true
APE_RETRIEVAL__RERANK_MODE=always
APE_RETRIEVAL__RERANK_TOP_N=20
APE_RETRIEVAL__RERANK_CANDIDATE_WINDOW=25
APE_RETRIEVAL__RERANK_RETURN_N=8
# Reranker backend: noop | lexical | embedding | embedding_max | cohere
# Local default noop (RRF order). hosted_managed uses cohere rerank-v4.0-pro.
APE_RETRIEVAL__RERANKER_BACKEND=noop
APE_RETRIEVAL__LANGUAGE_METADATA_SCHEMA_VERSION=2026-08-18.v1
APE_RETRIEVAL__MAX_CHUNKS_PER_DOCUMENT=4
APE_RETRIEVAL__MAX_CHUNKS_PER_SECTION=2
APE_RETRIEVAL__DEDUPLICATE_BY_CONTENT_HASH=true
APE_RETRIEVAL__PASSAGE_SCORING_ENABLED=false
APE_RETRIEVAL__PASSAGE_WINDOW_TOKENS=96
APE_RETRIEVAL__PASSAGE_OVERLAP_TOKENS=24
APE_RETRIEVAL__PASSAGE_MIN_TOKENS=32
APE_RETRIEVAL__MODIFIES_EXPANSION_ENABLED=false
APE_RETRIEVAL__MODIFIES_EXPANSION_MODE=off
APE_RETRIEVAL__MAX_RELATED_SOURCES=8
APE_RETRIEVAL__MAX_RELATIONSHIP_CANDIDATES=20

# ----------------------------------------------------------------------------
# Upload malware scanning
# ----------------------------------------------------------------------------
# Development/test may use disabled. Production startup requires clamav.
APE_MALWARE_SCAN__BACKEND=disabled
APE_MALWARE_SCAN__HOST=localhost
APE_MALWARE_SCAN__PORT=3310
APE_MALWARE_SCAN__TIMEOUT_SECONDS=15

# ----------------------------------------------------------------------------
# LLM (conversations / Chat)
# ----------------------------------------------------------------------------
# Backend: echo | openai | openai_compatible | ollama | gemini
APE_LLM__BACKEND=echo
APE_LLM__MODEL=gpt-4o-mini
# Optional intentional override; omit to use the provider/model default.
# APE_LLM__TEMPERATURE=0.7
APE_LLM__MAX_TOKENS=4096
APE_LLM__REQUEST_TIMEOUT_SECONDS=120
APE_LLM__OLLAMA_BASE_URL=http://localhost:11434
# APE_LLM__OPENAI_API_KEY=
# APE_LLM__OPENAI_BASE_URL=https://api.openai.com
# APE_LLM__GEMINI_API_KEY=
# APE_LLM__GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ----------------------------------------------------------------------------
# External web search (used only by explicit Project chat response modes)
# ----------------------------------------------------------------------------
# Backend: disabled | openai. Omit backend/model/base URL/credential to inherit
# a compatible APE_LLM__* OpenAI configuration. `disabled` is an explicit kill switch.
# APE_WEB_SEARCH__BACKEND=disabled
# APE_WEB_SEARCH__MODEL=
APE_WEB_SEARCH__MAX_RESULTS=8
APE_WEB_SEARCH__MAX_EVIDENCE_CHARS=12000
APE_WEB_SEARCH__MAX_OUTPUT_TOKENS=4096
APE_WEB_SEARCH__REQUEST_TIMEOUT_SECONDS=45
# Optional dedicated connection values; omitted values reuse APE_LLM__OPENAI_*.
# APE_WEB_SEARCH__OPENAI_API_KEY=
# APE_WEB_SEARCH__OPENAI_BASE_URL=

# ----------------------------------------------------------------------------
# Contextual generation
# ----------------------------------------------------------------------------
APE_GENERATION__MAX_REQUEST_BYTES=262144
APE_GENERATION__MAX_CONTEXT_BYTES=204800
APE_GENERATION__MAX_SCHEMA_BYTES=32768
APE_GENERATION__MAX_CONTEXT_DEPTH=12
APE_GENERATION__MAX_CONTEXT_NODES=5000
APE_GENERATION__DEFAULT_RETENTION=none
APE_GENERATION__ALLOW_FULL_RETENTION=true

# ----------------------------------------------------------------------------
# Query-only retrieval translation (off for hash/echo pytest; on for hosted_managed)
# Max one target. Original query always runs. Projects: Inherit / On / Off.
# ----------------------------------------------------------------------------
APE_QUERY_TRANSLATION__ENABLED=false
APE_QUERY_TRANSLATION__BACKEND=openai
APE_QUERY_TRANSLATION__MODEL=gpt-5-nano
APE_QUERY_TRANSLATION__PROMPT_VERSION=retrieval-translation-v2
APE_QUERY_TRANSLATION__MAX_OUTPUT_TOKENS=4096
APE_QUERY_TRANSLATION__REQUEST_TIMEOUT_SECONDS=45
APE_QUERY_TRANSLATION__TARGET_LANGUAGES=bn,en

# Shared Cohere credential (canonical). Embedding and rerank models stay separate.
# APE_COHERE__API_KEY=
APE_COHERE__BASE_URL=https://api.cohere.com
APE_RERANKER__COHERE_MODEL=rerank-v4.0-pro
APE_RERANKER__REQUEST_TIMEOUT_SECONDS=30
# Legacy fallbacks for older rerank-only deploys:
# APE_RERANKER__COHERE_API_KEY=
# APE_RERANKER__COHERE_BASE_URL=https://api.cohere.com

# ----------------------------------------------------------------------------
# Chat / RAG orchestration
# ----------------------------------------------------------------------------
# indexed_only | indexed_then_web | indexed_and_web
APE_CHAT__RESPONSE_MODE=indexed_only
APE_CHAT__RETRIEVAL_TOP_K=10
APE_CHAT__MAX_CONTEXT_CHUNKS=8
APE_CHAT__CONTEXT_CHAR_BUDGET=12000
APE_CHAT__MAX_HISTORY_MESSAGES=20
APE_CHAT__SYSTEM_PROMPT_VERSION=v5
APE_CHAT__INCLUDE_CITATIONS=true
APE_CHAT__EVIDENCE_SCORE_MODE=whole_chunk
# Local and hosted_managed examples enforce. Use observe only while measuring.
APE_CHAT__EVIDENCE_GATE_MODE=enforce
APE_CHAT__MINIMUM_SEMANTIC_EVIDENCE_SCORE=0.35
APE_CHAT__MINIMUM_RERANKER_EVIDENCE_SCORE=0.40
APE_CHAT__CANDIDATE_WISE_GROUNDING_ENABLED=false
APE_CHAT__LEXICAL_CORROBORATION_FLOOR_SCORE=0.30
APE_CHAT__LEXICAL_CORROBORATION_COVERAGE=0.50
APE_CHAT__MINIMUM_CLAIM_TOKEN_COVERAGE=0.35
APE_CHAT__MINIMUM_CLAIM_SEMANTIC_SCORE=0.25
APE_CHAT__CLAIM_SEMANTIC_REJECT_FLOOR=0.15

# ----------------------------------------------------------------------------
# Evidence-quality evaluation
# ----------------------------------------------------------------------------
APE_EVALUATION__EVALUATOR_VERSION=quality-v3
APE_EVALUATION__DEFAULT_TOP_K=5
APE_EVALUATION__MAX_CASES_PER_DATASET=500
APE_EVALUATION__MINIMUM_RECALL_AT_K=0.80
APE_EVALUATION__MINIMUM_RANK_1_ACCURACY=0.80
APE_EVALUATION__MINIMUM_CROSS_LINGUAL_RECALL_AT_K=0.75
APE_EVALUATION__MINIMUM_FILTERED_CORRECTNESS=0.95
APE_EVALUATION__MAXIMUM_FALSE_REFUSAL_RATE=0.10
APE_EVALUATION__MAXIMUM_FALSE_ACCEPT_RATE=0.0
APE_EVALUATION__MAXIMUM_ACCEPTED_WITHOUT_RELEVANT_EVIDENCE_RATE=0.0
APE_EVALUATION__MINIMUM_GROUNDEDNESS=0.80
APE_EVALUATION__MINIMUM_CITATION_COVERAGE=0.80
APE_EVALUATION__MAXIMUM_P95_LATENCY_MS=750
APE_EVALUATION__MAXIMUM_METRIC_REGRESSION=0.02
APE_EVALUATION__MINIMUM_RERANKER_NDCG_GAIN=0.02
APE_EVALUATION__MAXIMUM_RERANKER_LATENCY_PENALTY_MS=150
APE_EVALUATION__RERANKER_CANDIDATES=lexical,embedding,embedding_max

# ----------------------------------------------------------------------------
# MinIO (S3-compatible object storage)
# ----------------------------------------------------------------------------
APE_MINIO__ENDPOINT=localhost:9000
APE_MINIO__ACCESS_KEY=minioadmin
APE_MINIO__SECRET_KEY=minioadmin
APE_MINIO__SECURE=false
APE_MINIO__BUCKET=ape-artifacts
