# Copy to runtime.env, chmod 600, and populate from the deployment secrets manager.
# Never commit runtime.env, tls.crt, or tls.key.
#
# Preferred profile is hosted_managed (Cohere embed+pro rerank, OpenAI luna/nano,
# Google OCR). hosted_openai remains a deprecated compatibility profile that still
# certifies OpenAI embeddings and must not suddenly require Cohere.

APE_APP__ENV=production
APE_APP__DEBUG=false
APE_APP__VERSION=0.9.0
# Immutable Phase-2 capability identity. Keep the runtime alias only for the
# one-release compatibility window.
APE_RUNTIME__CAPABILITY_PROFILE_ID=hosted-managed@v1
APE_RUNTIME__PROFILE=hosted_managed
APE_LOGGING__RENDER_JSON=true
APE_CORS__ALLOW_ORIGINS=https://rag-builder.example
APE_AUTH__ENABLED=true
APE_AUTH__ADMIN_JWT_SECRET=replace-with-32-plus-random-bytes
APE_AUTH__KEY_PEPPER=replace-with-32-plus-random-bytes
APE_WEBHOOKS__ENABLED=true
APE_WEBHOOKS__DISPATCHER_ENABLED=true
APE_WEBHOOKS__SIGNING_KEY=replace-with-32-plus-random-bytes
APE_DATABASE__HOST=postgres
APE_DATABASE__PORT=5432
APE_DATABASE__USER=ape
APE_DATABASE__PASSWORD=replace-database-password
APE_DATABASE__NAME=ape
POSTGRES_USER=ape
POSTGRES_PASSWORD=replace-database-password
POSTGRES_DB=ape
APE_REDIS__HOST=redis
APE_REDIS__PORT=6379
APE_REDIS__PASSWORD=replace-redis-password
REDIS_PASSWORD=replace-redis-password
APE_STORAGE__BACKEND=minio
APE_MINIO__ENDPOINT=minio:9000
APE_MINIO__ACCESS_KEY=replace-minio-access-key
APE_MINIO__SECRET_KEY=replace-minio-secret-key
APE_MINIO__BUCKET=ape-artifacts
MINIO_ROOT_USER=replace-minio-access-key
MINIO_ROOT_PASSWORD=replace-minio-secret-key
MINIO_BUCKET=ape-artifacts
APE_MALWARE_SCAN__BACKEND=clamav
APE_MALWARE_SCAN__HOST=clamav
APE_MALWARE_SCAN__PORT=3310
APE_JOBS__BACKEND=taskiq

# OCR — enable Google Vision when scans or Bangla/custom-font PDFs need it.
APE_OCR__ENABLED=true
APE_OCR__BACKEND=google_vision
APE_OCR__BANGLA_BACKEND=google_vision
APE_OCR__LANG=en
APE_OCR__GOOGLE_API_KEY=replace-google-vision-secret
APE_OCR__GOOGLE_ENDPOINT=https://vision.googleapis.com/v1/images:annotate
APE_OCR__GOOGLE_TIMEOUT_SECONDS=30
APE_OCR__GOOGLE_MAX_ATTEMPTS=3
APE_OCR__BANGLA_MIN_RATIO=0.10
APE_OCR__MAX_OCR_PAGES_PER_DOCUMENT=100

# Embedding — hosted_managed Cohere embed-v4 @ 1024, embedding set 3.
# Changing provider/model requires rebuild → validate → activate. Never mix
# OpenAI and Cohere vectors in one active set.
APE_EMBEDDING__BACKEND=cohere
APE_EMBEDDING__MODEL=embed-v4.0
APE_EMBEDDING__DIMENSIONS=1024
APE_RETRIEVAL__EMBEDDING_SET_VERSION=3

# Generation — OpenAI is required on hosted profiles.
APE_LLM__BACKEND=openai
APE_LLM__MODEL=gpt-5.6-luna
APE_LLM__OPENAI_API_KEY=replace-openai-secret
APE_WEB_SEARCH__BACKEND=openai
APE_WEB_SEARCH__MODEL=gpt-5.6-luna
# Optional; empty reuses APE_LLM__OPENAI_API_KEY.
APE_WEB_SEARCH__OPENAI_API_KEY=
APE_GENERATION__DEFAULT_RETENTION=none
APE_GENERATION__ALLOW_FULL_RETENTION=false

# Retrieval — hybrid + Always rerank. Projects may inherit or opt down.
APE_RETRIEVAL__STRATEGY=hybrid
APE_RETRIEVAL__RERANK_MODE=always
APE_RETRIEVAL__RERANKER_BACKEND=cohere

# Translation — off by default. Projects override Inherit / On / Off.
# Enable only after gazette hard gates pass. Failure keeps original-query retrieval.
APE_QUERY_TRANSLATION__ENABLED=false
APE_QUERY_TRANSLATION__BACKEND=openai
APE_QUERY_TRANSLATION__MODEL=gpt-5-nano
APE_QUERY_TRANSLATION__PROMPT_VERSION=retrieval-translation-v2
APE_QUERY_TRANSLATION__MAX_OUTPUT_TOKENS=4096
APE_QUERY_TRANSLATION__REQUEST_TIMEOUT_SECONDS=45

# Shared Cohere credential and base URL for embed and rerank. Models stay separate.
APE_COHERE__API_KEY=replace-cohere-secret
APE_COHERE__BASE_URL=https://api.cohere.com
APE_RERANKER__COHERE_MODEL=rerank-v4.0-pro
# Legacy fallbacks for older rerank-only deploys:
# APE_RERANKER__COHERE_API_KEY=
# APE_RERANKER__COHERE_BASE_URL=https://api.cohere.com

# Evidence — enforce with current defaults. Use observe only while measuring.
APE_CHAT__RESPONSE_MODE=indexed_only
APE_CHAT__SYSTEM_PROMPT_VERSION=v6
APE_CHAT__EVIDENCE_GATE_MODE=enforce
APE_CHAT__GROUNDING_MODE=strict
APE_CHAT__MINIMUM_SEMANTIC_EVIDENCE_SCORE=0.35
APE_CHAT__MINIMUM_RERANKER_EVIDENCE_SCORE=0.40

APE_AI_POLICY__DEFAULT_RAG_PROFILE=standard
APE_AI_POLICY__DEFAULT_GENERATION_MODEL_ID=openai-gpt-5.6-luna
APE_AI_POLICY__ALLOWED_GENERATION_MODEL_IDS=openai-gpt-5.6-luna
APE_AI_POLICY__MAX_REQUEST_TOP_K=100
APE_AI_POLICY__ENABLED_RETRIEVAL_STRATEGIES=semantic,hybrid
APE_AI_POLICY__SOURCE_POLICY_MODE=enforce
APE_AI_POLICY__SOURCE_POLICY_DEPLOYMENT_CAP=enforce
